import pandas as pd
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
import streamlit as st

# Sample Music Dataset (replace with your actual data)
data = {
    'song_name': ['Rowdy Baby', 'Innum Konjam Naeram', 'Vaseegara', 'Why This Kolaveri Di', 'Anbil Avan',
                  'Munbe Vaa', 'Appadi Podu', 'Enna Sona', 'Kutti Story', 'Vaathi Coming'],
    'singer': ['Dhanush & Dhee', 'GV Prakash Kumar & Saindhavi', 'Bombay Jayashri & Harris Jayaraj', 'Dhanush', 'Shreya Ghoshal & Harris Jayaraj',
               'Naresh Iyer & Shreya Ghoshal', 'Anushka Manchanda, Benny Dayal, Blaaze', 'Sid Sriram & Darshan Raval', 'Vijay & Anirudh Ravichander', 'Anirudh Ravichander & Gana Balachandar'],
    'genre': ['Tamil Pop', 'Tamil Romantic', 'Tamil Romantic', 'Tamil Folk Pop', 'Tamil Romantic',
              'Tamil Romantic', 'Tamil Dance', 'Tamil Romantic', 'Tamil Pop', 'Tamil Dance'],
    'mood': ['Energetic', 'Melancholic', 'Love', 'Humorous', 'Love',
             'Love', 'Party', 'Love', 'Happy', 'Party'],
    'description': [
